body {
    background-color: #ffffff;
    font-family: "Segoe UI", Tahoma, sans-serif;
    margin: 20px;
}

#main-container {
    max-width: 500px;
    margin: 0 auto;
}

#header {
    font-size: 35px;
    text-align: center;
    font-weight: bold;
    margin-bottom: 10px;
}

.date-selection {
    text-align: center;
    margin-bottom: 20px;
}

.section {
    padding: 20px;
    margin-bottom: 20px;
    border-radius: 25px;
    box-shadow: 2px 2px 10px rgba(0,0,0,0.05);
}

.pink { background-color: rgba(242, 225, 225, 1); }
.beige { background-color: rgba(233, 221, 208, 1); }
.blue { background-color: rgba(214, 224, 233, 1); }
.purple { background-color: rgba(222, 214, 224, 1); }

h2 {
    font-size: 18px;
    text-align: center;
    margin-top: 0;
}

.input-group {
    display: flex;
    gap: 5px;
}

input[type="text"] {
    flex: 1;
    padding: 8px;
    border-radius: 10px;
    border: 1px solid rgba(0,0,0,0.1);
}

button {
    padding: 8px 15px;
    border-radius: 10px;
    border: none;
    background-color: #333;
    color: white;
    font-weight: bold;
    cursor: pointer;
}

button:hover {
    background-color: #555;
}

ul {
    padding: 0;
    list-style: none;
}

ul li {
    padding: 8px 0;
    border-bottom: 1px solid rgba(255,255,255,0.5);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.completed {
    text-decoration: line-through;
    opacity: 0.6;
}
